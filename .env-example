# =============================================================================
# GraphRAG Code Review Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env-example .env

# --- Neo4j (Required) --------------------------------------------------------
APP_NEO4J_URL=bolt://localhost:7687
APP_NEO4J_USER=neo4j
APP_NEO4J_PASSWORD=your_password_here
APP_NEO4J_DATABASE=neo4j

# --- Embedding / Vector Search (optional — enabled by default) ---------------
# EMBEDDING_ENABLED=true           # set false to skip embedding on indexing
# EMBEDDING_MODEL=all-MiniLM-L6-v2 # 384-dim fast model; or microsoft/codebert-base (768-dim)
# EMBEDDING_VECTOR_DIM=384         # must match model output; 768 for codebert-base

# --- GitHub (Required for PR review) -----------------------------------------
GITHUB_TOKEN=ghp_your_token_here

# --- LLM Role Architecture ---------------------------------------------------
#
#  fast_gate  : classifier + evaluator (binary decisions — keep small/fast)
#  chat       : agent loop + tool routing (needs strong reasoning)
#  generation : fix_bug / refactor / planner / reviewer (core coding tasks)
#
# Recommended setup with self-hosted DeepSeek 32B:
#
#   fast_gate → Groq llama-3.1-8b-instant (free, fast, enough for intent classification)
#   chat      → DeepSeek 32B via vLLM     (tool routing needs real intelligence)
#   generation→ DeepSeek 32B via vLLM     (all coding tasks share the same GPU endpoint)
#
GROQ_API_KEY=gsk_your-key-here

# 4-role LLM architecture:
#   fast_gate  → small/fast model (binary decisions, intent classification)
#   reason     → reasoning-specialized (Phase 2 fault analysis, Planner, Reflexion)
#   generation → code-specialized (Phase 3 patch writing only)
#   chat       → agent loop + tool routing (strong general reasoning)
#
# Recommended Groq free-tier setup (no GPU needed):
#
FAST_LLM_PROVIDER=groq
FAST_LLM_MODEL=llama-3.1-8b-instant

REASON_LLM_PROVIDER=groq
REASON_LLM_MODEL=deepseek-r1-distill-llama-70b

# generation falls back to LLM_PROVIDER/LLM_MODEL when not set
# GEN_LLM_PROVIDER=groq
# GEN_LLM_MODEL=llama-3.3-70b-versatile

# chat falls back to fast_gate when not set
# CHAT_LLM_PROVIDER=groq
# CHAT_LLM_MODEL=llama-3.3-70b-versatile
#
# Self-hosted vLLM setup (GPU recommended):
#   fast_gate  → llama-3.1-8b-instant on RTX 3090      (VLLM_FAST_BASE)
#   reason     → DeepSeek-R1-Distill-Qwen-32B on A100  (VLLM_REASON_BASE)
#   generation → DeepSeek-R1-Distill-Qwen-32B on A100  (VLLM_GEN_BASE)
#   reason + generation can share the same server endpoint
#
# GEN_LLM_PROVIDER=vllm
# GEN_LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
# REASON_LLM_PROVIDER=vllm
# REASON_LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
# VLLM_GEN_BASE=http://localhost:8000/v1
# VLLM_REASON_BASE=http://localhost:8000/v1  ← same server OK
# VLLM_FAST_BASE=http://localhost:8001/v1

# Default fallback (used by code_context.py and any direct get_llm() call)
LLM_PROVIDER=vllm
LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
LLM_TEMPERATURE=0

# --- Start vLLM server with DeepSeek 32B: ------------------------------------
# pip install vllm
# python -m vllm.entrypoints.openai.api_server \
#   --model deepseek-ai/DeepSeek-R1-Distill-Qwen-32B \
#   --dtype float16 --max-model-len 16384 --port 8000
#
# GPU requirement: ~65GB VRAM (2x RTX 3090 / 1x A100 80GB)
# For 4-bit quantized: ~20GB VRAM (1x RTX 3090)
#   add: --quantization awq  (use deepseek-ai/DeepSeek-R1-Distill-Qwen-32B-AWQ)
# -----------------------------------------------------------------------------

# Available Groq models (all free — use for fast_gate):
#   llama-3.1-8b-instant      — fastest
#   llama-3.3-70b-versatile   — best quality
#   gemma2-9b-it              — Google Gemma

# For local Ollama (dev only):
# LLM_PROVIDER=ollama
# LLM_MODEL=deepseek-coder:6.7b-instruct

# For OpenAI (when LLM_PROVIDER=openai):
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-your-key-here

# --- Reflexion settings -------------------------------------------------------
REFLEXION_MAX_RETRIES=3

# --- GraphRAG retrieval bounds (scalability) ----------------------------------
RETRIEVER_TOP_K=20
RETRIEVER_MAX_HOPS=3
RETRIEVER_MAX_CONTEXT_NODES=500

# --- Langfuse Observability (optional — trace every LLM call) -----------------
# Get keys at https://cloud.langfuse.com → Settings → API Keys
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
# LANGFUSE_SECRET_KEY=sk-lf-your-key-here
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Execution-based verification gates ---------------------------------------
# EXECUTION_GATE_ENABLED=true           # set false to skip test execution gate
# EXECUTION_GATE_TIMEOUT=300            # max seconds to wait for tests
# EXECUTION_GATE_TEST_CMD=python -m pytest --tb=short -q

# --- GitHub PR integration (opt-in) ------------------------------------------
# Post review findings as a comment directly on the GitHub PR after review.
# Requires GITHUB_TOKEN with repo scope (read:repo is not enough for comments).
# GITHUB_POST_REVIEW_COMMENTS=false

# Auto-create a fix branch PR with the generated patches applied.
# Requires GITHUB_TOKEN with push access to the reviewed repo (repo scope).
# The fix branch is named bot/fix-pr{number} and targets the PR's base branch.
# GITHUB_AUTO_FIX_PR=false
