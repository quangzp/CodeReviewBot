# =============================================================================
# GraphRAG Code Review Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env-example .env

# --- Neo4j (Required) --------------------------------------------------------
APP_NEO4J_URL=bolt://localhost:7687
APP_NEO4J_USER=neo4j
APP_NEO4J_PASSWORD=your_password_here
APP_NEO4J_DATABASE=neo4j

# --- Embedding / Vector Search (optional — enabled by default) ---------------
# EMBEDDING_ENABLED=true           # set false to skip embedding on indexing
# EMBEDDING_MODEL=all-MiniLM-L6-v2 # 384-dim fast model; or microsoft/codebert-base (768-dim)
# EMBEDDING_VECTOR_DIM=384         # must match model output; 768 for codebert-base

# --- GitHub (Required for PR review) -----------------------------------------
GITHUB_TOKEN=ghp_your_token_here

# --- LLM Provider (choose one) -----------------------------------------------
# Options: groq (free!), ollama (free local), openai (paid API), together (API)

# RECOMMENDED: Groq (free, fast, 70B model)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
GROQ_API_KEY=gsk_your-key-here

# Available Groq models (all free tier):
#   llama-3.3-70b-versatile         — best quality (recommended)
#   deepseek-r1-distill-llama-70b   — strong reasoning
#   llama-3.1-8b-instant            — fastest
#   gemma2-9b-it                    — Google Gemma

# For local Ollama (when LLM_PROVIDER=ollama):
# LLM_MODEL=deepseek-coder:6.7b-instruct

# For OpenAI (when LLM_PROVIDER=openai):
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-your-key-here

# For Together.ai (when LLM_PROVIDER=together):
# LLM_MODEL=openai/gpt-oss-20b
# TOGETHER_API_KEY=your-key-here

# --- Reflexion settings -------------------------------------------------------
REFLEXION_MAX_RETRIES=3

# --- GraphRAG retrieval bounds (scalability) ----------------------------------
RETRIEVER_TOP_K=20
RETRIEVER_MAX_HOPS=3
RETRIEVER_MAX_CONTEXT_NODES=500

# --- Langfuse Observability (optional — trace every LLM call) -----------------
# Get keys at https://cloud.langfuse.com → Settings → API Keys
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
# LANGFUSE_SECRET_KEY=sk-lf-your-key-here
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Execution-based verification gates ---------------------------------------
# EXECUTION_GATE_ENABLED=true           # set false to skip test execution gate
# EXECUTION_GATE_TIMEOUT=300            # max seconds to wait for tests
# EXECUTION_GATE_TEST_CMD=python -m pytest --tb=short -q
